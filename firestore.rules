rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    function isDirector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'director';
    }

    // Perfis. O admin é criado manualmente no console (role: 'admin').
    // O diretor só cria o próprio perfil junto com o consumo atômico de um convite válido.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'schoolName', 'inviteCode', 'createdAt'])
        && request.resource.data.role == 'director'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.schoolName == request.resource.data.schoolName
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == uid;

      // Admin edita dados do diretor (nome e escola) e pode remover o perfil (revoga o acesso).
      allow update: if isAdmin()
        && resource.data.role == 'director'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'schoolName'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.schoolName is string && request.resource.data.schoolName.size() > 0;
      allow delete: if isAdmin() && resource.data.role == 'director';
    }

    // Convites. O código é um UUID aleatório: quem tem o link consegue ler (get), mas ninguém lista.
    match /invites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.used == false
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0;
      allow delete: if isAdmin();

      // Admin edita o nome da escola e renova a validade.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolName', 'expiresAt'])
        && request.resource.data.schoolName is string && request.resource.data.schoolName.size() > 0;

      // Marcar como usado: somente o novo usuário, uma única vez, mexendo só nos campos de uso.
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']);
    }

    // Professores: cada diretor acessa apenas os seus; o admin vê e gerencia todos.
    match /teachers/{id} {
      allow read: if isAdmin() || (isDirector() && resource.data.directorId == request.auth.uid);

      // A escola é gravada na criação, sempre igual à do perfil do diretor.
      allow create: if isDirector()
        && request.resource.data.directorId == request.auth.uid
        && request.resource.data.get('schoolName', '') == userDoc(request.auth.uid).data.schoolName
        && validTeacher(request.resource.data);

      // lastEmailedAt (data do último envio do certificado) só aceita a hora do servidor.
      allow update: if validTeacher(request.resource.data)
        && request.resource.data.directorId == resource.data.directorId
        && (request.resource.data.get('lastEmailedAt', null) == resource.data.get('lastEmailedAt', null)
            || request.resource.data.lastEmailedAt == request.time)
        && (
          (isDirector()
            && resource.data.directorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'subject', 'schoolName', 'lastEmailedAt'])
            && request.resource.data.get('schoolName', userDoc(request.auth.uid).data.schoolName) == userDoc(request.auth.uid).data.schoolName)
          ||
          (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'subject', 'schoolName', 'lastEmailedAt']))
        );

      allow delete: if isAdmin() || (isDirector() && resource.data.directorId == request.auth.uid);
    }

    // Certificados emitidos: verificação pública por código (get), sem listagem, imutáveis.
    match /certificates/{code} {
      allow get: if true;
      allow list: if isAdmin() || (isDirector() && resource.data.directorId == request.auth.uid);
      allow create: if isDirector()
        && request.resource.data.directorId == request.auth.uid
        && request.resource.data.issuedAt == request.time
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId))
        && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.directorId == request.auth.uid;
      allow update, delete: if false;
    }

    function validTeacher(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.email is string
        && d.get('subject', '') is string
        && d.get('schoolName', '') is string;
    }
  }
}
