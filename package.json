  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-env.mjs serve",
    "build": "node scripts/ng-env.mjs build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/ng-env.mjs test",
    "deploy": "bash scripts/deploy.sh tudo",
